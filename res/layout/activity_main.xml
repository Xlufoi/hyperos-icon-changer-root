<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HyperOS Icon Changer"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AOSP shapes, RGB Monet color wheel, opacity &amp; scale customization"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp" />

        <!-- Live Preview Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="16dp"
            android:gravity="center"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE PREVIEW"
                android:textColor="@color/accent_blue"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageView
                    android:id="@+id/preview_icon1"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="6dp" />

                <ImageView
                    android:id="@+id/preview_icon2"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="6dp" />

                <ImageView
                    android:id="@+id/preview_icon3"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="6dp" />

                <ImageView
                    android:id="@+id/preview_icon4"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="6dp" />

                <ImageView
                    android:id="@+id/preview_icon5"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Customization Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <!-- Shape selector -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Icon Shape (AOSP):"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinner_shape"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/btn_secondary"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- Icon Style selector -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Icon Style:"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinner_style"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/btn_secondary"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- Glyph Color Selector (RGB Palette) -->
            <LinearLayout
                android:id="@+id/layout_glyph_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btn_pick_glyph_color"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@color/btn_secondary"
                    android:text="🎨 Glyph Color (RGB Wheel)"
                    android:textColor="@color/accent_blue"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/view_glyph_color_preview"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tv_glyph_hex"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#0284C7"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Background Plate Color (ONLY RGB Palette) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Background Plate Color:"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btn_pick_plate_color"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@color/btn_secondary"
                    android:text="🎨 Plate Color (RGB Wheel)"
                    android:textColor="@color/accent_blue"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/view_plate_color_preview"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tv_plate_hex"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#38BDF8"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Opacity Slider -->
            <TextView
                android:id="@+id/tv_opacity_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Plate Opacity: 70%"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekbar_opacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="70"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp" />

            <!-- Corner Radius Slider -->
            <TextView
                android:id="@+id/tv_radius_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Corner Radius: 36%"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekbar_radius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="50"
                android:progress="36"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp" />

            <!-- Content Scale Slider -->
            <TextView
                android:id="@+id/tv_fill_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Icon Content Scale: 65%"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekbar_fill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="65"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- HyperOS Apply Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_hyperos"
                android:textColor="@color/accent_blue"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Applies selected shape, colors, scale, and opacity to ALL apps in HyperOS (Root)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_apply_hyperos"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_apply_hyperos"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@color/accent_blue" />

            <Button
                android:id="@+id/btn_restore_hyperos"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/btn_restore_hyperos"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginTop="10dp"
                android:background="@color/btn_secondary" />
        </LinearLayout>

        <!-- Launcher Apply Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="18dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_launchers"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Apply as an icon pack in Nova, Lawnchair, Smart Launcher, etc."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btn_apply_launcher"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/btn_apply_launcher"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:background="@color/btn_secondary" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
