<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HyperOS Icon Changer"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Кастомизация значков HyperOS: AOSP формы, Monet, прозрачность и масштаб"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp" />

        <!-- Live Preview Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="16dp"
            android:gravity="center"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ЖИВОЙ ПРЕДПРОСМОТР"
                android:textColor="@color/accent_blue"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageView
                    android:id="@+id/preview_icon1"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="6dp" />

                <ImageView
                    android:id="@+id/preview_icon2"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="6dp" />

                <ImageView
                    android:id="@+id/preview_icon3"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="6dp" />

                <ImageView
                    android:id="@+id/preview_icon4"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="6dp" />

                <ImageView
                    android:id="@+id/preview_icon5"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Customization Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <!-- Shape selector -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Форма значков (AOSP):"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinner_shape"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/btn_secondary"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- Icon Style selector -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Стиль картинки значка:"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinner_style"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/btn_secondary"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- Palette selector -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Цвет подложки:"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinner_theme"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/btn_secondary"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- Opacity Slider -->
            <TextView
                android:id="@+id/tv_opacity_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Прозрачность подложки: 70%"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekbar_opacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="70"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp" />

            <!-- Fill / Scale Slider -->
            <TextView
                android:id="@+id/tv_fill_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Заполнение картинки: 65%"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekbar_fill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="65"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- HyperOS Apply Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_hyperos"
                android:textColor="@color/accent_blue"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Применяет выбранные форму, стиль, масштаб и прозрачность на ВСЕ приложения в HyperOS (Root)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_apply_hyperos"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_apply_hyperos"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@color/accent_blue"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btn_restore_hyperos"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="@string/btn_restore_hyperos"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:background="@color/btn_secondary" />
        </LinearLayout>

        <!-- Launcher Icon Pack Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_launchers"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Для POCO Launcher, Lawnchair, Nova Launcher"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btn_apply_launcher"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="@string/btn_apply_launcher"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:background="@color/btn_secondary" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
