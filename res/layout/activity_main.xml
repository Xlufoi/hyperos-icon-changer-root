<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/theme_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Полупрозрачные (70%) Monet значки из BlueOS. Настройка форм из AOSP."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp" />

        <!-- Live Preview Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="16dp"
            android:gravity="center"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ПРЕДПРОСМОТР ЗНАЧКОВ"
                android:textColor="@color/accent_blue"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageView
                    android:id="@+id/preview_icon1"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:src="@drawable/ic_settings"
                    android:layout_margin="6dp" />

                <ImageView
                    android:id="@+id/preview_icon2"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:src="@drawable/ic_phone"
                    android:layout_margin="6dp" />

                <ImageView
                    android:id="@+id/preview_icon3"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:src="@drawable/ic_messages"
                    android:layout_margin="6dp" />

                <ImageView
                    android:id="@+id/preview_icon4"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:src="@drawable/ic_camera"
                    android:layout_margin="6dp" />

                <ImageView
                    android:id="@+id/preview_icon5"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:src="@drawable/ic_telegram"
                    android:layout_margin="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Customization Card (Shapes & Themes) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <!-- Shape selector -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Форма значков (AOSP):"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinner_shape"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/btn_secondary"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- Palette selector -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Цветовая палитра:"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinner_theme"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/btn_secondary"
                android:layout_marginTop="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </LinearLayout>

        <!-- HyperOS Apply Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_hyperos"
                android:textColor="@color/accent_blue"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Применяет выбранную форму и Monet 70% на ВСЕ приложения в HyperOS (без ThemeManager)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_apply_hyperos"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_apply_hyperos"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@color/accent_blue"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btn_restore_hyperos"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="@string/btn_restore_hyperos"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:background="@color/btn_secondary" />
        </LinearLayout>

        <!-- Launcher Icon Pack Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_launchers"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Для POCO Launcher, Lawnchair, Nova Launcher"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btn_apply_launcher"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="@string/btn_apply_launcher"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:background="@color/btn_secondary" />
        </LinearLayout>

        <!-- Magisk Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_magisk"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Модуль сохранён в /sdcard/Download/BlueOS_HyperOS/BlueOS-Glass-Icons-Module.zip"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
